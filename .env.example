# Mailchimp Marketing API — required for applying tag 3531655 (Holding Page) on signups.
# post-json signup does not apply tags; names use MMERGE2 / MMERGE1.
# Create a key: Mailchimp → Account → Extras → API keys
NUXT_MAILCHIMP_API_KEY=
NUXT_MAILCHIMP_TAG_ID=3531655
# Optional fallback if tag id lookup fails (Audience → Tags → "Holding Page")
NUXT_MAILCHIMP_TAG_NAME=Holding Page
